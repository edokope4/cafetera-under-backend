# Copia este archivo a .env y completa los valores.
# El JSON de la cuenta de servicio de Firebase va en ./secrets/firebase.json
# y dentro del contenedor se lee desde la ruta de abajo.

MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC=cl/kope/iot/cafetera/status
# Si se omite, se usa el tópico de estado sin /status.
# Ahí se publica el mismo JSON con "action": "turn-off".
MQTT_COMMAND_TOPIC=cl/kope/iot/cafetera
MQTT_QOS=1
MQTT_CLIENT_ID=cafetera-backend

# Se envía la push solo cuando el JSON trae este code.
NOTIFY_CODE=4
NOTIFY_TITLE=Cafetera

FCM_PROJECT_ID=
FCM_TOKEN=
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase.json
